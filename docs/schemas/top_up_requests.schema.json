{
  "$jsonSchema": {
    "bsonType": "object",
    "properties": {
      "_id": {
        "bsonType": "objectId"
      },
      "userId": {
        "bsonType": "objectId"
      },
      "tokens": {
        "bsonType": "int",
        "minimum": 1
      },
      "amountCOP": {
        "bsonType": [
          "long",
          "int"
        ],
        "minimum": 1
      },
      "nequiReference": {
        "bsonType": "string",
        "minLength": 4,
        "maxLength": 40
      },
      "receiptId": {
        "bsonType": "objectId",
        "description": "file in the GridFS bucket 'receipts' (JPG, PNG or PDF <= 5 MB)"
      },
      "status": {
        "bsonType": "string",
        "enum": [
          "PENDING",
          "APPROVED",
          "REJECTED"
        ]
      },
      "reviewedBy": {
        "bsonType": [
          "objectId",
          "null"
        ]
      },
      "rejectionReason": {
        "bsonType": [
          "string",
          "null"
        ]
      },
      "createdAt": {
        "bsonType": "date"
      },
      "resolvedAt": {
        "bsonType": [
          "date",
          "null"
        ]
      }
    },
    "additionalProperties": false,
    "required": [
      "_id",
      "userId",
      "tokens",
      "amountCOP",
      "nequiReference",
      "receiptId",
      "status",
      "createdAt"
    ]
  }
}
