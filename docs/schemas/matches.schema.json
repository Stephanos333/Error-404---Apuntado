                  "id": {
                    "bsonType": "string",
                    "enum": [
                      "classic",
                      "apuntado"
                    ]
                  },
                  "version": {
                    "bsonType": "string",
                    "pattern": "^\\d+\\.\\d+\\.\\d+$"
                  }
