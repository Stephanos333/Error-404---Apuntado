# Variables de docker-compose.yml (se leen de ./.env).
# start.sh / start.bat copian esta plantilla a .env y generan secretos JWT aleatorios.

# --- Seguridad (OBLIGATORIAS): use valores largos y aleatorios; nunca los suba al repositorio.
JWT_SECRET=CAMBIAR_POR_UN_SECRETO_ALEATORIO
JWT_REFRESH_SECRET=CAMBIAR_POR_OTRO_SECRETO_ALEATORIO
JWT_EXPIRATION_TIME=6h
JWT_REFRESH_EXPIRATION_TIME=10d

# --- Parámetros del sistema (PS) que se congelan en cada partida.
APP_DEFAULT_TOKENS=100
APP_FALSE_WIN_PENALTY_POINTS=3
APP_BONUS_POINTS=10

# --- Base de datos. Por defecto, el replica set local del contenedor `mongodb`.
# Para MongoDB Atlas: MONGODB_URI=mongodb+srv://<usuario>:<clave>@<cluster>/apuntado?retryWrites=true&w=majority
MONGODB_URI=mongodb://mongodb:27017/apuntado?replicaSet=rs0

# --- Puertos publicados en el host.
FRONTEND_PORT=5173
BACKEND_PORT=3000
MONGO_PORT=27017

# --- URLs públicas.
# Vacío = el frontend llama al backend por el mismo origen (proxy de Nginx). En la nube con
# dominios separados, ponga aquí la URL pública del backend (se incrusta al compilar el frontend).
VITE_BACKEND_BASE_URL=
VITE_FRONTEND_BASE_URL=http://localhost:5173
BACKEND_PUBLIC_URL=http://localhost:3000
