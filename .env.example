# docker-compose.yml variables (read from ./.env).
# start.sh / start.bat copy this template to .env and generate random JWT secrets.

# --- Security (REQUIRED): use long random values; never commit them to the repository.
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_SECRET
JWT_REFRESH_SECRET=CHANGE_ME_TO_ANOTHER_RANDOM_SECRET
JWT_EXPIRATION_TIME=6h
JWT_REFRESH_EXPIRATION_TIME=10d

# --- System parameters (PS) frozen in every match.
APP_DEFAULT_TOKENS=100
APP_FALSE_WIN_PENALTY_POINTS=3
APP_BONUS_POINTS=10

# --- Database. By default, the local replica set of the `mongodb` container.
# For MongoDB Atlas: MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/apuntado?retryWrites=true&w=majority
MONGODB_URI=mongodb://mongodb:27017/apuntado?replicaSet=rs0

# --- Ports published on the host.
FRONTEND_PORT=5173
BACKEND_PORT=3000
MONGO_PORT=27017

# --- Public URLs.
# Empty = the frontend calls the backend on the same origin (Nginx proxy). In the cloud with
# separate domains, put the public backend URL here (it is embedded when the frontend is built).
VITE_BACKEND_BASE_URL=
VITE_FRONTEND_BASE_URL=http://localhost:5173
BACKEND_PUBLIC_URL=http://localhost:3000
