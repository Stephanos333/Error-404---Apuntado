# BACKEND
# En desarrollo (yarn dev) el backend corre aparte en el puerto 3000.
# En Docker se deja vacío: Nginx reenvía /api y /socket.io al backend (mismo origen).
VITE_BACKEND_BASE_URL='http://localhost:3000'
VITE_FRONTEND_BASE_URL='http://localhost:5173'
# Las imágenes están en public/assets/images, que Vite sirve en /assets/images.
VITE_PROFILE_IMAGES_URL='/assets/images/profile/'
VITE_CARD_IMAGES_URL='/assets/images/card/'
