package "src/rules/contract" as CONTRACT {

  interface GameRulePlugin <<interface>> {
    + descriptor : RuleDescriptor {readOnly}
    + dealSettings() : DealSettings
    + allowedCloses() : ReadonlyArray<CloseType>
    + validateClose(hand : DeclaredHand, type : CloseType) : ValidationResult
    + closeEffect(result : ValidationResult, closeType : CloseType) : CloseEffect
    + settleRound(hands : ReadonlyArray<OpponentHand>) : RoundSettlement
    + evaluateOutcome(scoreboard : Scoreboard, closerId : string) : Outcome
  }

  class RuleDescriptor <<interface>> {
    + id : string {readOnly}
    + name : string {readOnly}
    + version : string {readOnly}
    + contractVersion : string {readOnly}
    + multiRound : boolean {readOnly}
  }

  class ContractCard <<interface>> {
    {field} + rank : number {readOnly}  — 1 (A) .. 13 (K)
    + suit : ContractSuit {readOnly}
  }

  class DeclaredHand <<interface>> {
    + groups : ReadonlyArray<ReadonlyArray<ContractCard>>
    + leftovers : ReadonlyArray<ContractCard>
    + discard? : ContractCard
  }

  class OpponentHand <<interface>> {
    + playerId : string
    + groups : ReadonlyArray<ReadonlyArray<ContractCard>>
    + leftovers : ReadonlyArray<ContractCard>
  }

  class ValidationResult <<interface>> {
    + valid : boolean
    + reason? : string
  }

  class CloseEffect <<interface>> {
    + endsRound : boolean
    + extraRound : boolean
    + pointsAdjustment : number
  }

  class DealSettings <<interface>> {
    + cardsPerPlayer : number
    + firstPlayerCards : number
  }

  class RoundSettlement <<interface>> {
    + penalties : Readonly<Record<string, number>>
  }

  class Outcome <<interface>> {
    + finished : boolean
    + winnerId? : string
    + eliminated : ReadonlyArray<string>
  }

  class Scoreboard <<type>> {
    Readonly<Record<string, number>>
  }

  enum CloseType <<enumeration>> {
    WIN_4_3_3
    KNOCK
  }

  enum ContractSuit <<enumeration>> {
    CLUB
    DIAMOND
    HEART
    SPADE
  }

  GameRulePlugin *-- "1" RuleDescriptor : descriptor
  DeclaredHand o-- "0..*" ContractCard
  OpponentHand o-- "0..*" ContractCard
  ContractCard --> "1" ContractSuit
}

package "src/rules/evaluator" as EVAL {

  interface IHandEvaluator <<interface>> {
    + isMeld(group : ReadonlyArray<ContractCard>) : boolean
    + isThree(group : ReadonlyArray<ContractCard>) : boolean
    + isFour(group : ReadonlyArray<ContractCard>) : boolean
    + isFourAndTwoThrees(groups : ReadonlyArray<ReadonlyArray<ContractCard>>) : boolean
    + areThreeThrees(groups : ReadonlyArray<ReadonlyArray<ContractCard>>) : boolean
    + points(cards : ReadonlyArray<ContractCard>) : number
    + unmatchedPoints(groups : ReadonlyArray<ReadonlyArray<ContractCard>>, leftovers : ReadonlyArray<ContractCard>) : number
  }

  class HandEvaluator {
    - runPolicy : RunPolicy = 'WITH_WRAP' {readOnly}
    + constructor(runPolicy : RunPolicy = 'WITH_WRAP')
    {method} + «las 7 operaciones de IHandEvaluator»
  }

  class "hand-evaluator" as HandEvaluatorModule <<utility>> {
    + TOTAL_RANKS : number = 13 {readOnly}
    + MAX_COPIES_PER_CARD : number = 2 {readOnly}
    - POINTS_BY_RANK : readonly number[] {readOnly}
    + isValidCard(card : ContractCard) : boolean
    + cardPoints(card : ContractCard) : number
    + isSameRankGroup(group : ReadonlyArray<ContractCard>) : boolean
    + isRun(group : ReadonlyArray<ContractCard>, policy : RunPolicy = 'WITH_WRAP') : boolean
    - maxCopies(group : ReadonlyArray<ContractCard>) : number
    - isLinear(values : ReadonlyArray<number>) : boolean
    - gaps(values : ReadonlyArray<number>) : number
    - isCircularSequence(values : ReadonlyArray<number>) : boolean
    - isSequenceWithoutWrap(values : ReadonlyArray<number>) : boolean
  }

  enum RunPolicy <<enumeration>> {
    WITH_WRAP
    WITHOUT_WRAP
  }

  HandEvaluator ..|> IHandEvaluator
  HandEvaluator --> "1" RunPolicy : runPolicy
  HandEvaluator ..> HandEvaluatorModule : <<use>>
  HandEvaluatorModule ..> RunPolicy
}

package "src/rules/registry" as REGISTRY {

  class RuleRegistry {
    - rules : Map<string, GameRulePlugin> {readOnly}
    - defaultId? : string
    - coreVersion : string = CONTRACT_VERSION {readOnly}
    + constructor(coreVersion : string = CONTRACT_VERSION)
    + register(plugin : GameRulePlugin, options : RegistryOptions = {}) : void
    + get(id? : string) : GameRulePlugin
    + exists(id : string) : boolean
    + <<get>> isDefault() : string | undefined
    + ids() : string[]
    - validateShape(plugin : GameRulePlugin, id : string | undefined) : void
    - smokeTest(plugin : GameRulePlugin, id : string) : void
  }

  class RegistryOptions <<interface>> {
    + isDefault? : boolean
  }

  class PluginIncompatibleError

  class RuleNotRegisteredError

  RuleRegistry o-- "0..*" GameRulePlugin : rules
  RuleRegistry ..> RegistryOptions
  RuleRegistry ..> PluginIncompatibleError : <<throw>>
  RuleRegistry ..> RuleNotRegisteredError : <<throw>>
}

package "backend/plugins" as PLUGINS {

  class ClassicRulePlugin {
    + descriptor : RuleDescriptor = {id: 'classic', multiRound: false} {readOnly}
    - evaluator : IHandEvaluator {readOnly}
    + constructor(evaluator : IHandEvaluator = new HandEvaluator())
    + dealSettings() : DealSettings
    + allowedCloses() : ReadonlyArray<CloseType>
    + validateClose(hand : DeclaredHand, type : CloseType) : ValidationResult
    + closeEffect(result : ValidationResult) : CloseEffect
    + settleRound(hands : ReadonlyArray<OpponentHand>) : RoundSettlement
    + evaluateOutcome(scoreboard : Scoreboard, closerId : string) : Outcome
  }

  class ApuntadoRulePlugin {
    + descriptor : RuleDescriptor = {id: 'apuntado', multiRound: true} {readOnly}
    - parameters : ApuntadoParameters {readOnly}
    - evaluator : IHandEvaluator {readOnly}
    + constructor(parameters : Partial<ApuntadoParameters> = {}, evaluator : IHandEvaluator = new HandEvaluator())
    + dealSettings() : DealSettings
    + allowedCloses() : ReadonlyArray<CloseType>
    + validateClose(hand : DeclaredHand, type : CloseType) : ValidationResult
    + closeEffect(result : ValidationResult, type : CloseType) : CloseEffect
    + settleRound(hands : ReadonlyArray<OpponentHand>) : RoundSettlement
    + evaluateOutcome(scoreboard : Scoreboard) : Outcome
    - validateFourAndTwoThrees(hand : DeclaredHand) : ValidationResult
    - validateKnock(hand : DeclaredHand) : ValidationResult
  }

  class ApuntadoParameters <<interface>> {
    + eliminationLimit : number = 101
    + victoryLimit : number = -51
    + knockThreshold : number = 5
    + closeBonus : number = 10
    + falseClosePenalty : number = 3
  }

  ApuntadoRulePlugin *-- "1" ApuntadoParameters : parameters
}

package "src/domain/match" as DOMAIN {

  class Match <<interface>> {
    + _id : string
    + invitationCode : string
    + name : string
    + status : MatchStatus
    + hostId : string
    + settings : MatchSettings
    + players : MatchPlayer[]
    + pot : MatchPot
    + currentRound : MatchRound | null
    + scoreboard : ScoreboardEntry[]
    + winnerId : string | null
    + resultsWindowUntil : Date | null
    {field} + recentCommands : string[]  — máx. 20 (idempotencia)
    + version : number  — concurrencia optimista
    + createdAt : Date
    + updatedAt : Date
    + finishedAt : Date | null
  }

  class MatchSettings <<interface>> {
    + mode : string
    + plugin : {id : string, version : string}
    + capacity : number
    + betPerPlayer : number
    + visibility : 'PUBLIC' | 'PRIVATE'
    + runType : 'WITH_WRAP' | 'WITHOUT_WRAP'
    + jokersEnabled : boolean
    + rebuyEnabled : boolean
    + negativeVictoryEnabled : boolean
    + parameters : MatchParameters
  }

  class MatchParameters <<interface>> {
    + eliminationLimit, knockThreshold, invalidClosePenalty : number
    + closeBonus, negativeVictoryThreshold, jokerValue : number
    + jokersPerDeck, twoDeckPlayers : number
    + disconnectGraceSec, resultsWindowSec : number
  }

  class MatchPlayer <<interface>> {
    {field} + playerId : string  — userId (UUID)
    + userId : string  — ObjectId hex
    + username : string
    + position : number
    + status : MatchPlayerStatus
    + score : number
    + usedRebuy : boolean
    + connected : boolean
    + disconnectedSince : Date | null
  }

  class MatchPot <<interface>> {
    + total : number
    + contributions : PotContribution[]
  }

  class PotContribution <<interface>> {
    + userId : string
    + type : 'BET' | 'REBUY'
    + amount : number
    + ledgerEntryId : string
  }

  class MatchRound <<interface>> {
    + number : number
    + status : RoundStatus
    + startPosition : number
    + turn : MatchTurn
    + deck : MatchCard[]
    + discardPile : MatchCard[]
    + hands : PlayerHand[]
    + extraRound : ExtraRound | null
  }

  class MatchTurn <<interface>> {
    + playerId : string
    + phase : TurnPhase
    + closeAttempted : boolean
    + number : number
  }

  class PlayerHand <<interface>> {
    + playerId : string
    + cards : MatchCard[]
    + groups : number[][]  — índices de cartas
  }

  class ExtraRound <<interface>> {
    + knockerId : string
    + pending : string[]
  }

  class MatchCard <<interface>> {
    + rank : CardRank
    + suit : CardSuit
    + deckNumber : number  — 1 o 2
  }

  class ScoreboardEntry <<interface>> {
    + roundNumber : number
    + winnerId : string
    + closeType : 'WIN_4_3_3' | 'KNOCK'
    + points : RoundPoints[]
    + closedAt : Date
  }

  class RoundPoints <<interface>> {
    + playerId : string
    + roundPoints : number
    + penalties : number
    + cumulative : number
    + eliminated : boolean
    + rebought : boolean
  }

  enum MatchStatus <<enumeration>> {
    WAITING
    IN_PROGRESS
    SHOWING_RESULTS
    FINISHED
    CANCELLED
  }

  enum RoundStatus <<enumeration>> {
    DEALING
    IN_TURNS
    EXTRA_ROUND
    SETTLING
    CLOSED
  }

  enum TurnPhase <<enumeration>> {
    AWAITING_DRAW
    HOLDING_11_CARDS
  }

  enum MatchPlayerStatus <<enumeration>> {
    IN_LOBBY
    ACTIVE
    ELIMINATED
    WINNER
    LOSER
  }

  enum CardRank <<enumeration>> {
    ACE, TWO, THREE, FOUR, FIVE, SIX, SEVEN
    EIGHT, NINE, TEN, J, Q, K
  }

  enum CardSuit <<enumeration>> {
    CLUBS
    DIAMONDS
    HEARTS
    SPADES
  }

  class "match-commands" as MatchCommandsModule <<utility>> {
    - MAX_GROUPS : number = 4 {readOnly}
    - MAX_CARDS_PER_GROUP : number = 4 {readOnly}
    + createMatch(data : NewMatchData, deal : DealSettings, shuffler : Shuffler) : TransitionResult
    + dealRound(match : Match, num : number, startPosition : number, deal : DealSettings, shuffler : Shuffler) : MatchRound
    + draw(current : Match, playerId : string, source : DrawSource, shuffler : Shuffler) : TransitionResult
    + discard(current : Match, playerId : string, index : number, groups : unknown, context : RuleContext) : TransitionResult
    + attemptClose(current : Match, playerId : string, data : CloseData, context : RuleContext) : TransitionResult
    + activePlayers(match : Match) : MatchPlayer[]
    + roundInTurns(match : Match) : MatchRound
    + checkTurn(match : Match, playerId : string) : MatchRound
    + validateGroups(groups : unknown, handSize : number, excluded : number[]) : number[][]
    + reindexWithoutCard(groups : number[][], removed : number) : number[][]
    - requireAllowedClose(rule : GameRulePlugin, round : MatchRound, type : CloseType) : void
    - startExtraRound(match, round, knock) : TransitionResult
    - advanceExtraRound(match, round, playerId, card, context) : TransitionResult
    - closeRound(match, round, closeAttempt : ValidClose, context) : TransitionResult
    - concludeRound(match, round, winner : RoundWinner, roundPoints, context, previousEvents, discard?) : TransitionResult
    - finish(match, outcome : Outcome, closerId, now, events) : TransitionResult
    - scoreboardEntry(roundNumber, winner, participants, roundPoints, eliminated, now) : ScoreboardEntry
    - declaredHand(cards, groups : number[][], discarded : number) : DeclaredHand
    - opponentHand(hand : PlayerHand) : OpponentHand
    - discardOnClose() · drawFromDeck() · drawFromDiscard() · nextActive() · orderFrom()
    - leftovers() · isWellFormedGroup() · requirePhase() · requireIndex() · player() · handOf() · clone()
  }

  class TransitionResult <<interface>> {
    + match : Match {readOnly}
    + events : MatchEvent[] {readOnly}
    + finished : boolean {readOnly}
  }

  class MatchEvent <<interface>> {
    + type : MatchEventType {readOnly}
    + playerId? : string {readOnly}
    + detail : Readonly<Record<string, unknown>> {readOnly}
  }

  enum MatchEventType <<enumeration>> {
    MATCH_STARTED
    CARD_DRAWN
    TURN_CHANGED
    CLOSE_FAILED
    PLAYER_KNOCKED
    ROUND_CLOSED
    ROUND_STARTED
    MATCH_FINISHED
  }

  class RuleContext <<interface>> {
    + rule : GameRulePlugin
    + shuffler : Shuffler
    + now : Date
  }

  class CloseData <<interface>> {
    + type : CloseType
    + groups : unknown  — índices por grupo
    + discard : number
  }

  class "match-cards" as MatchCardsModule <<utility>> {
    + toContractCard(card : MatchCard) : ContractCard
    + createDeck(decks : number) : MatchCard[]
  }

  interface Shuffler <<interface>> {
    + shuffle<T>(items : ReadonlyArray<T>) : T[]
  }

  class SecureShuffler {
    + shuffle<T>(items : ReadonlyArray<T>) : T[]  — Fisher-Yates + crypto.randomInt
  }

  class "match-views" as MatchViewsModule <<utility>> {
    + publicView(match : Match) : PublicMatchView
    + privateView(match : Match, playerId : string) : PrivateMatchView | null
  }

  class MatchUpdatedEvent {
    + roomId : string {readOnly}
    + match : Match {readOnly}
    + events : ReadonlyArray<MatchEvent> {readOnly}
    + constructor(roomId : string, match : Match, events : ReadonlyArray<MatchEvent>)
  }

  class MatchConflictException <<HTTP 409>>
  class InvalidMatchException <<HTTP 400>>

  Match *-- "1" MatchSettings : settings
  MatchSettings *-- "1" MatchParameters : parameters
  Match *-- "2..*" MatchPlayer : players
  Match *-- "1" MatchPot : pot
  MatchPot *-- "0..*" PotContribution : contributions
  Match *-- "0..1" MatchRound : currentRound
  Match *-- "0..*" ScoreboardEntry : scoreboard
  ScoreboardEntry *-- "1..*" RoundPoints : points
  MatchRound *-- "1" MatchTurn : turn
  MatchRound *-- "2..*" PlayerHand : hands
  MatchRound *-- "0..1" ExtraRound : extraRound
  MatchRound *-- "0..*" MatchCard : deck
  MatchRound *-- "0..*" MatchCard : discardPile
  PlayerHand *-- "0..11" MatchCard : cards

  Match --> MatchStatus
  MatchRound --> RoundStatus
  MatchTurn --> TurnPhase
  MatchPlayer --> MatchPlayerStatus
  MatchCard --> CardRank
  MatchCard --> CardSuit

  MatchCommandsModule ..> Match : <<transforma (structuredClone)>>
  MatchCommandsModule ..> TransitionResult : <<create>>
  MatchCommandsModule ..> MatchCardsModule : <<use>>
  MatchCommandsModule ..> MatchConflictException : <<throw>>
  MatchCommandsModule ..> InvalidMatchException : <<throw>>
  TransitionResult o-- "0..*" MatchEvent : events
  MatchEvent --> MatchEventType
  RuleContext --> "1" Shuffler : shuffler
  MatchCommandsModule ..> RuleContext
  SecureShuffler ..|> Shuffler
  MatchViewsModule ..> Match : <<filtra (R04)>>
  MatchUpdatedEvent o-- "1" Match : match
  MatchUpdatedEvent o-- "0..*" MatchEvent : events
}

package "src/application/match" as APPLICATION {

  class TurnOrchestrator <<@Injectable>> {
    - matches : MatchRepository {readOnly}
    - ledger : TokenLedgerRepository {readOnly}
    - unitOfWork : UnitOfWork {readOnly}
    - ruleRegistry : RuleRegistry {readOnly}
    - eventBus : EventBus {readOnly}
    - shuffler : Shuffler {readOnly}
    - parameters : MatchParameters {readOnly}
    - userModel : Model<UserRecord> {readOnly}
    - gameModel : Model<GameRecord> {readOnly}
    - playerModel : Model<PlayerRecord> {readOnly}
    + startMatch(game : Game, requester : UserId) : Promise<Match>
    + draw(command : TurnCommand, source : DrawSource) : Promise<CommandResult>
    + discard(command : TurnCommand, card : number, groups? : number[][]) : Promise<CommandResult>
    + attemptClose(command : TurnCommand, type : CloseType, groups : number[][], discard : number) : Promise<CommandResult>
    + getState(matchId : string, userId : string) : Promise<StateForUser>
    - execute(command : TurnCommand, apply : (Match, GameRulePlugin) => TransitionResult) : Promise<CommandResult>
    - save(next : Match, command : TurnCommand, finished : boolean) : Promise<void>
    - resolveConflict(command : TurnCommand, base : Match) : Promise<CommandResult>
    - payPot(match : Match, roomId : string, session : ClientSession) : Promise<void>
    - chargeBets() · newMatchData() — auxiliares de startMatch
    - load(matchId : string) : Promise<Match>
    - publish(roomId : string, result : TransitionResult) : void
  }

  class TurnCommand <<interface>> {
    + roomId : string
    + matchId : string
    + userId : string
    + version : number
    + commandId : string
  }

  class CommandResult <<interface>> {
    + applied : boolean
    + match : Match
  }

  class StateForUser <<interface>> {
    + publicView : PublicMatchView
    + privateView : PrivateMatchView | null
  }

  class "match.mapper" as Mapper <<utility>> {
    + toRecord(match : Match) : MatchRecord
    + toDomain(record : MatchRecord) : Match
  }

  class UnmatchedWriteError

  TurnOrchestrator ..> TurnCommand
  TurnOrchestrator ..> CommandResult : <<create>>
  TurnOrchestrator ..> StateForUser : <<create>>
  TurnOrchestrator ..> Mapper : <<use>>
  TurnOrchestrator ..> UnmatchedWriteError : <<throw / catch>>
}

package "src/database" as DATABASE {

  class MatchRepository <<@Injectable>> {
    + findById(id : Types.ObjectId, session? : ClientSession) : Promise<MatchRecord | null>
    + insert(match : MatchRecord, session? : ClientSession) : Promise<void>
    + updateIfMatches(match : MatchRecord, condition : CommandCondition, session? : ClientSession) : Promise<boolean>
  }

  class CommandCondition <<interface>> {
    + version : number
    + playerId : string
    + commandId : string
  }

  class TokenLedgerRepository <<@Injectable>> {
    + register(ledgerEntries : TokenLedgerEntryRecord[], session : ClientSession) : Promise<void>
  }

  class UnitOfWork <<@Injectable>> {
    + execute<T>(work : (session : ClientSession) => Promise<T>) : Promise<T>
  }

  class MatchRecord <<interface>>
  class TokenLedgerEntryRecord <<interface>>

  MatchRepository ..> CommandCondition
  MatchRepository ..> MatchRecord
  TokenLedgerRepository ..> TokenLedgerEntryRecord
}

class RulePluginsModule <<composition root · @Global @Module>> {
  + createRuleRegistry(env = process.env) : RuleRegistry
  + readSystemParameters(env = process.env) : MatchParameters
  - apuntadoParameters(system : MatchParameters) : ApuntadoParameters
}

ClassicRulePlugin ..|> GameRulePlugin
ApuntadoRulePlugin ..|> GameRulePlugin
ClassicRulePlugin --> "1" IHandEvaluator : evaluator
ApuntadoRulePlugin --> "1" IHandEvaluator : evaluator
RulePluginsModule ..> RuleRegistry : <<create>>
RulePluginsModule ..> ClassicRulePlugin : <<create>>
RulePluginsModule ..> ApuntadoRulePlugin : <<create>>
IHandEvaluator ..> ContractCard
HandEvaluatorModule ..> ContractCard

TurnOrchestrator --> "1" RuleRegistry : ruleRegistry
TurnOrchestrator --> "1" Shuffler : shuffler
TurnOrchestrator --> "1" MatchRepository : matches
TurnOrchestrator --> "1" TokenLedgerRepository : ledger
TurnOrchestrator --> "1" UnitOfWork : unitOfWork
TurnOrchestrator --> "1" MatchParameters : parameters
TurnOrchestrator ..> MatchCommandsModule : <<use>>
TurnOrchestrator ..> MatchViewsModule : <<use>>
TurnOrchestrator ..> MatchUpdatedEvent : <<create / publish>>
TurnOrchestrator ..> GameRulePlugin : <<use>>
RuleContext --> "1" GameRulePlugin : rule
MatchCommandsModule ..> GameRulePlugin : <<use>>
MatchCardsModule ..> ContractCard : <<traduce>>
Mapper ..> MatchRecord

legend right
  + público · - privado · «utility»: módulo de funciones (+ exportada, - interna) · sin miembros # en el MVP
  Solo RulePluginsModule conoce los plug-ins concretos; el núcleo depende del contrato (DIP).
endlegend
@enduml
