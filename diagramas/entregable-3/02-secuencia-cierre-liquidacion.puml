@startuml 02-secuencia-cierre-liquidacion
' =====================================================================================
' Entregable 3 · Sección 1.2 · Diagrama UML 2.5 de secuencia del flujo crítico:
' intento de cierre de ronda y liquidación de la puntuación.
' Fuente de verdad: match-play.controller.ts, turn-orchestrator.service.ts,
' match-commands.ts, classic-rule.plugin.ts, apuntado-rule.plugin.ts,
' match.repository.ts, unit-of-work.ts, token-ledger.repository.ts,
' match-updated.event-handler.ts, game.socket.ts, match-notifications.ts
' =====================================================================================
title Sistema Apuntado · Secuencia del flujo crítico: intento de cierre de ronda y liquidación\n<size:11>Entregable 3 · ruta síncrona del comando (ADR-05): leer · calcular en memoria · escribir una vez · notificar</size>

skinparam shadowing false
' Estilo neutro (equivalente al tema por defecto de PlantUML moderno)
skinparam backgroundColor #FFFFFF
skinparam TitleFontStyle bold
skinparam TitleFontSize 14
skinparam ArrowColor #181818
skinparam ArrowFontColor #000000
skinparam NoteBackgroundColor #FEFFDD
skinparam NoteBorderColor #181818
skinparam LegendBackgroundColor #DDDDDD
skinparam LegendBorderColor #181818
skinparam ParticipantBackgroundColor #E2E2F0
skinparam ParticipantBorderColor #181818
skinparam ActorBackgroundColor #E2E2F0
skinparam ActorBorderColor #181818
skinparam DatabaseBackgroundColor #E2E2F0
skinparam DatabaseBorderColor #181818
skinparam SequenceLifeLineBorderColor #181818
skinparam SequenceGroupBorderColor #181818
skinparam SequenceGroupHeaderFontStyle bold
skinparam SequenceDividerBackgroundColor #EEEEEE
skinparam SequenceDividerBorderColor #181818
skinparam SequenceReferenceBorderColor #181818
skinparam ClassBackgroundColor #F1F1F1
skinparam ClassBorderColor #181818
skinparam ClassHeaderBackgroundColor #F1F1F1
skinparam InterfaceBackgroundColor #F1F1F1
skinparam InterfaceBorderColor #181818
skinparam PackageBorderColor #181818
skinparam PackageBackgroundColor #FFFFFF
skinparam NodeBackgroundColor #FFFFFF
skinparam NodeBorderColor #181818
skinparam ArtifactBackgroundColor #F1F1F1
skinparam ArtifactBorderColor #181818
skinparam ComponentBackgroundColor #F1F1F1
skinparam ComponentBorderColor #181818
skinparam CloudBackgroundColor #FFFFFF
skinparam CloudBorderColor #181818
skinparam QueueBackgroundColor #F1F1F1
skinparam QueueBorderColor #181818
skinparam RectangleBorderColor #181818
skinparam UsecaseBorderColor #181818
skinparam StorageBorderColor #181818
skinparam StorageBackgroundColor #F1F1F1
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam sequenceMessageAlign left
skinparam responseMessageBelowArrow true
skinparam maxMessageSize 300
skinparam sequenceGroupBodyBackgroundColor transparent
hide footbox
scale max 4000 height
autonumber "<b>00"

actor "Jugador\n(SPA React)" as UI
participant "MatchPlayController\n<<REST>>\n/api/matches/current" as CTRL
participant "TurnOrchestrator\n<<aplicación>>" as TO
participant "RuleRegistry\n<<microkernel>>" as REG
participant "match-commands\n<<dominio puro>>" as DOM
participant "GameRulePlugin\n<<interface>>\n(Clásica · Apuntado)" as PL
participant "MatchRepository\n<<driver nativo>>" as REPO
participant "UnitOfWork\n(ClientSession)" as UOW
participant "TokenLedger\nRepository" as LIB
database "MongoDB rs0" as DB
participant "EventBus (CQRS)\nMatchUpdated\nEventHandler" as BUS
participant "GameSocket\n<<gateway Socket.IO>>\n/game" as GW

' ------------------------------------------------------------------------------------
group Precondición · al abrir el tablero
  UI -> GW : emit GAME_CONNECTION_EVENT\n(WebSocket, JWT en el handshake)
  GW -> GW : GameAuthGuard resuelve el juego del usuario\nsocket.join(["match:{gameId}", "user:{userId}"])
end

== Comando de cierre (HTTP síncrono) ==

UI -> CTRL : POST /commands/close\n{ type: WIN_4_3_3 | KNOCK, groups: number[][],\n  discard: number, version: v, commandId: UUID v4 }\nAuthorization: Bearer JWT
activate CTRL
CTRL -> TO : attemptClose(command{roomId, matchId, userId,\nversion, commandId}, type, groups, discard)
activate TO
TO -> REPO : findById(matchId)
REPO -> DB : matches.findOne({ _id })
DB --> REPO : MatchRecord (version = v)
REPO --> TO : record → toDomain()

break commandId ∈ recentCommands (reenvío del mismo comando)
  TO --> CTRL : { applied: false, match }
  CTRL --> UI : 200 OK (idempotente: no repite el efecto)
end

TO -> REG : get(settings.plugin.id)
REG --> TO : rule : GameRulePlugin
TO -> DOM : attemptClose(match, playerId, { type, groups, discard },\n{ rule, shuffler, now })
activate DOM
DOM -> DOM : clone() · checkTurn() · requirePhase(HOLDING_11_CARDS)\nrequireAllowedClose() · validateGroups()

break la ronda no está IN_TURNS / EXTRA_ROUND, o el turno es de otro jugador
  DOM --> CTRL : MatchConflictException\n(ROUND_ALREADY_CLOSED | NOT_YOUR_TURN)
  CTRL --> UI : 409 Conflict
end

DOM -> PL : validateClose(declaredHand, type)
PL --> DOM : ValidationResult { valid, reason? }
DOM -> PL : closeEffect(result, type)
PL --> DOM : CloseEffect { endsRound, extraRound, pointsAdjustment }

' ------------------------------------------------------------------------------------
alt Escenario 1 · Modalidad Clásica (plug-in "classic") · 1 cuarta + 2 ternas + 1 descarte
  note over PL
    validateClose → ACCEPTED
    (0 sobrantes e isFourAndTwoThrees)
    closeEffect → { endsRound: true,
    extraRound: false, pointsAdjustment: 0 }
  end note
  DOM -> DOM : closeRound() → discardOnClose()
  DOM -> PL : settleRound(manos de los rivales)
  PL --> DOM : penalties = 0 (sin marcador histórico)
  DOM -> DOM : concludeRound()
  DOM -> PL : evaluateOutcome(scoreboard, closerId)
  PL --> DOM : { finished: true, winnerId: closer, eliminated: opponents }
  DOM -> DOM : finish(): status FINISHED, WINNER / LOSER\neventos ROUND_CLOSED, MATCH_FINISHED
  DOM --> TO : TransitionResult { finished: true }

else Escenario 2 · Modalidad Apuntado (plug-in "apuntado")

  alt 2.1 · type = KNOCK válido (3 ternas + 1 sobrante de menos de 5 puntos)
    note over PL
      closeEffect → { endsRound: false,
      extraRound: true, pointsAdjustment: 0 }
    end note
    DOM -> DOM : startExtraRound(): descarta y pasa la ronda a EXTRA_ROUND\nextraRound = { knockerId, pending: rivales en orden de turno }\nturn → pending[0] (AWAITING_DRAW)
    DOM --> TO : TransitionResult { events: [PLAYER_KNOCKED], finished: false }
    note over UI, DOM
      <b>Ronda extra:</b> cada rival pendiente juega su último turno con los comandos
      normales POST /commands/draw y POST /commands/discard (cada uno con su
      version y commandId). discard() → advanceExtraRound() lo quita de pending.
      El descarte del último pendiente ejecuta la liquidación del subcaso 2.2.
      Tocar otra vez durante la ronda extra responde CLOSE_NOT_ALLOWED.
    end note

  else 2.2 · cierre final de la ronda (4-3-3 válido, o último descarte de la ronda extra)
    alt 4-3-3 válido (POST /commands/close)
      note over PL
        closeEffect → { endsRound: true,
        pointsAdjustment: −10 } (bonificación)
      end note
      DOM -> PL : settleRound(manos organizadas de los rivales)
    else último descarte de la ronda extra (POST /commands/discard · misma ruta execute())
      DOM -> PL : settleRound(manos de TODOS los activos, incluido quien tocó)
    end
    PL --> DOM : penalties[playerId] = unmatchedPoints(groups, leftovers)
    DOM -> DOM : score += penalty (en memoria, sin escribir aún)
    DOM -> PL : evaluateOutcome(marcador acumulado, roundWinnerId)
    PL --> DOM : Outcome { finished, winnerId?, eliminated: score ≥ 101 }
    DOM -> DOM : scoreboard.push(ScoreboardEntry\n{ roundNumber, winnerId, closeType, points[] })
    alt outcome.finished (queda un solo jugador activo, o alguien llega a ≤ −51)
      DOM -> DOM : finish(): FINISHED · WINNER / LOSER / ELIMINATED\neventos ROUND_CLOSED, MATCH_FINISHED
      DOM --> TO : TransitionResult { finished: true }
    else la partida continúa (con 3 o más jugadores, 101 elimina pero no termina)
      DOM -> DOM : jugadores con ≥ 101 → ELIMINATED\ndealRound(n + 1) con SecureShuffler, en el mismo cálculo\neventos ROUND_CLOSED, ROUND_STARTED
      DOM --> TO : TransitionResult { finished: false }
    end
  end

else Cierre inválido (cualquier modalidad)
  DOM -> DOM : closeAttempted = true · score += castigo (+3 Apuntado, 0 Clásica)\nevento CLOSE_FAILED · el turno no cambia
  DOM --> TO : TransitionResult { finished: false }
end
deactivate DOM

break base.version ≠ command.version (el cliente actuó sobre un estado viejo)
  TO --> CTRL : MatchConflictException(STALE_VERSION)
  CTRL --> UI : 409 Conflict
end
TO -> TO : next = { ...result.match, version: v + 1,\nrecentCommands: [..., commandId].slice(−20) }

== Persistencia: una sola escritura condicional (persistir antes de notificar) ==

alt finished = false (2.1 · 2.2 con nueva ronda · cierre inválido)
  TO -> REPO : updateIfMatches(toRecord(next), { version: v, playerId, commandId })
  REPO -> DB : matches.updateOne(\n { _id, version: v, "currentRound.turn.playerId": playerId,\n   recentCommands: { $ne: commandId } },\n { $set: state, $inc: { version: 1 },\n   $push: { recentCommands: { $each: [commandId], $slice: −20 } } })
  DB --> REPO : matchedCount
  REPO --> TO : matched : boolean
else finished = true (Escenario 1 · 2.2 con fin de partida)
  TO -> UOW : execute(work)
  activate UOW
  UOW -> DB : startSession() · withTransaction(\nreadConcern snapshot · writeConcern majority · primary)
  UOW -> TO : work(session)
  TO -> REPO : updateIfMatches(next, condition, session)
  REPO -> DB : matches.updateOne(mismo filtro condicional) [session]
  DB --> REPO : matchedCount
  REPO --> TO : matched : boolean
  opt matched = true · payPot()
    TO -> LIB : register([POT_PRIZE { amount: pot.total,\nreference: "POT_PRIZE:{matchId}" }], session)
    LIB -> DB : token_ledger.insertMany() (índice único en reference)
    TO -> DB : users.updateOne($inc tokens del ganador) · users.updateMany(status ACTIVE)\ngames.updateOne(status FINISHED) · players.updateMany(isActive: false)
  end
  UOW -> DB : commitTransaction() (o abortTransaction() si no coincidió)
  UOW --> TO : fin de la transacción
  deactivate UOW
end

' ------------------------------------------------------------------------------------
alt matched = true · el comando ganó
  TO -> BUS : publish(MatchUpdatedEvent(roomId, next, events))\n<<solo después del commit>>
  activate BUS
  BUS -> GW : notifyMatch(roomId, match, events)
  GW -> GW : planNotifications() (función pura: vistas filtradas)
  GW ->> UI : sala pública "match:{gameId}":\nMATCH_WON_LISTENER · PLAYER_KNOCKED_LISTENER · PLAYER_CANT_WIN_LISTENER\nROUND_STARTED_LISTENER · GAME_FINISHED_LISTENER { event, match: vista pública }
  GW ->> UI : sala privada "user:{userId}": PRIVATE_HAND_LISTENER { hand }\n(solo los jugadores cuya mano cambió)
  deactivate BUS
  TO --> CTRL : { applied: true, match: next }
  CTRL --> UI : 200 OK { match: publicView, hand: privateView }

else matched = false · otro comando ganó la carrera (UnmatchedWriteError)
  TO -> TO : resolveConflict(command, base)
  TO -> REPO : findById(matchId) (relectura)
  REPO --> TO : partida vigente (version ≥ v + 1)
  alt el mismo commandId ya se aplicó
    TO --> CTRL : { applied: false, match }
    CTRL --> UI : 200 OK (idempotente)
  else la ronda ya no es la misma o ya no está en turnos
    TO --> CTRL : MatchConflictException(ROUND_ALREADY_CLOSED)
    CTRL --> UI : 409 Conflict (código ROUND_ALREADY_CLOSED)
    UI -> CTRL : GET /api/matches/current (relee el estado y descarta la intención)
  else el turno es de otro jugador
    TO --> CTRL : MatchConflictException(NOT_YOUR_TURN)
    CTRL --> UI : 409 Conflict
  else cualquier otro cambio
    TO --> CTRL : MatchConflictException(STALE_VERSION)
    CTRL --> UI : 409 Conflict
  end
end
deactivate TO
deactivate CTRL

legend right
  <b>Clave</b>
  ->   llamada síncrona            -->  respuesta
  ->>  mensaje asíncrono (Socket.IO)
  break  interrumpe el flujo y responde de inmediato
  alt / else  escenarios excluyentes · opt  paso condicional
  Plug-ins: ClassicRulePlugin (id "classic") y ApuntadoRulePlugin (id "apuntado")
endlegend
@enduml
