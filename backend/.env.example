# Variables del backend para ejecutarlo sin Docker (npm run start:dev).
# Con Docker se usan las del .env de la raíz (ver docker-compose.yml).

# APP
APP_PORT=3000
APP_URL=http://localhost:$APP_PORT
APP_GLOBAL_PREFIX="api"
APP_DOCS_URI="docs"
# Parámetros del sistema (PS) que se congelan en cada partida.
APP_DEFAULT_TOKENS=100
APP_FALSE_WIN_PENALTY_POINTS=3
APP_BONUS_POINTS=10

# MONGODB
# Debe ser un replica set (MongoDB Atlas lo es): el cobro de apuestas y el pago del pozo
# usan transacciones (ADR-04). Con el contenedor de docker-compose desde el host:
#   mongodb://localhost:27017/apuntado?directConnection=true
MONGODB_URI=""

# JWT (obligatorias; use secretos largos y aleatorios)
JWT_SECRET=""
JWT_EXPIRATION_TIME="6h"
JWT_REFRESH_SECRET=""
JWT_REFRESH_EXPIRATION_TIME="10d"
